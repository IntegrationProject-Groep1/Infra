# ==========================================
# CORE INFRASTRUCTURE
# ==========================================
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# Shared secret that allows RabbitMQ nodes to recognise each other in a cluster.
# Must be the same across all nodes. Use a random 32-char string.
RABBITMQ_ERLANG_COOKIE=

# External database port (default: 30004)
EXTERNAL_DB_PORT=30004

# Shared PostgreSQL (pgadmin + identity-service only)
DB_USER=
DB_PASSWORD=
DB_NAME=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Teams Webhook URLs (get from PM)
TEAMS_WEBHOOK_INFRA=
TEAMS_WEBHOOK_FRONTEND=
TEAMS_WEBHOOK_KASSA=
TEAMS_WEBHOOK_CRM=
TEAMS_WEBHOOK_PLANNING=
TEAMS_WEBHOOK_FACTURATIE=
TEAMS_WEBHOOK_MONITORING=

# ==========================================
# TEAM FRONTEND (DRUPAL)
# ==========================================
DRUPAL_DB_ROOT_PASS=
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal_user
DRUPAL_DB_PASS=
DRUPAL_BASE_URL=
RABBITMQFRONTEND_USER=
RABBITMQFRONTEND_PASS=

# ==========================================
# MONITORING (ELK)
# ==========================================
ES_ADMIN_USER=
ES_ADMIN_PASS=
# Heap size for Elasticsearch JVM. 512m is the minimum for single-node dev.
# Increase to 1g on the production VM if OOMKill events appear in the logs.
ES_MEM_LIMIT=512m
KIBANA_SYSTEM_PASS=
KIBANA_PUBLIC_BASE_URL=
RABBITMQMONITORING_USER=
RABBITMQMONITORING_PASS=

# ==========================================
# TEAM FACTURATIE (FOSSBILLING)
# ==========================================
FOSSBILLING_DB_NAME=
FOSSBILLING_DB_USER=
FOSSBILLING_DB_PASS=
RABBITMQFACTURATIE_USER=
RABBITMQFACTURATIE_PASS=

# ==========================================
# TEAM KASSA (ODOO)
# ==========================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASS=
# Odoo master password — required to create and manage databases from the web UI.
# This is separate from the per-user login password.
ODOO_MASTER_PASS=
RABBITMQKASSA_USER=
RABBITMQKASSA_PASS=

# ==========================================
# TEAM CRM
# ==========================================
RABBITMQCRM_USER=
RABBITMQCRM_PASS=
# Must be quoted if the password contains special chars like # or $
# Example: RABBITMQCRM_PASSRAW="your_password_here"
RABBITMQCRM_PASSRAW=
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ==========================================
# TEAM PLANNING
# ==========================================
RABBITMQPLANNING_USER=
RABBITMQPLANNING_PASS=

# ==========================================
# IDENTITY SERVICE
# ==========================================
IDENTITY_RABBIT_USER=
IDENTITY_RABBIT_PASS=

# ==========================================
# RABBITMQ SHARED
# ==========================================
# Internal cluster DNS name for the RabbitMQ service — do not change unless you
# rename the Kubernetes Service in base/core/rabbitmq/service.yaml.
RABBIT_HOST=rabbitmq_broker
RABBIT_PORT=5672
# Production vhost. Dev environment uses shift-festival-dev (configured manually).
RABBIT_VHOST=/
# Used by services that self-declare their queue bindings on startup.
RABBIT_AUTO_SETUP_TOPOLOGY=
RABBIT_EXCHANGE=
RABBIT_INCOMING_QUEUE=
POLL_INTERVAL=

# ==========================================
# CHATBOT (AI — Llama via NVIDIA API)
# ==========================================
# Admin credentials for the chatbot admin panel (format: username:password)
ADMIN_CREDENTIALS=
# Secret key used to sign admin session tokens — use a random 32+ char string
ADMIN_SECRET=

# NVIDIA NIM credentials
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Dedicated PostgreSQL for chatbot (sessions + logs — separate from identity-service DB)
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
CHATBOT_DB_NAME=chatbot

# Dedicated RabbitMQ user for chatbot RPC calls (identity, planning, facturatie, etc.)
RABBITMQCHATBOT_USER=
RABBITMQCHATBOT_PASS=

# RPC / session tuning
IDENTITY_RPC_QUEUE=identity.user.lookup.email.request
RPC_TIMEOUT=10.0
SESSION_TTL_SECONDS=3600

# MCP servers (localhost = sidecars in same pod — do not change unless you move them out)
MCP_SERVERS=sessions@http://localhost:8001/mcp,monitoring@http://localhost:8005/mcp

# Sessions MCP → Drupal JSON:API
FRONTEND_BASE_URL=https://desiderius.me

# Monitoring MCP → Elasticsearch (internal cluster DNS)
ELASTICSEARCH_URL=http://elasticsearch-service:9200
ES_USERNAME=elastic
# ES_PASSWORD is reused from ES_ADMIN_PASS (already in shift-secrets as ELASTIC_PASSWORD)
ES_LOGS_INDEX=logs-*
ES_HEARTBEAT_INDEX=heartbeats-*

# ==========================================
# CLOUDFLARE TUNNEL
# ==========================================
# Token generated in the Cloudflare Zero Trust dashboard under
# Networks → Tunnels. One token per tunnel instance. This value is stored
# in the cloudflare-tunnel-secret Kubernetes Secret (separate from shift-secrets)
# and must be created manually during initial setup and disaster recovery.
# See scripts/create-secret.sh and docs/disaster-recovery.md.
CLOUDFLARE_TUNNEL_TOKEN=