# =============================================================================
# .env.example — shift-secrets template
# ShiftFestival — Infra Team
#
# Copy this file to .env, fill in all values, then bootstrap with:
#   ./scripts/create-secret.sh setup/.env shift-festival
#
# NEVER commit the filled-in .env file. Real secrets live only on the VM.
# =============================================================================

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_ERLANG_COOKIE=

# Per-service RabbitMQ credentials (each service has its own vhost user)
RABBITMQFRONTEND_USER=
RABBITMQFRONTEND_PASS=
RABBITMQFRONTEND_PREFIX=

RABBITMQKASSA_USER=
RABBITMQKASSA_PASS=

RABBITMQFACTURATIE_USER=
RABBITMQFACTURATIE_PASS=

RABBITMQCRM_USER=
RABBITMQCRM_PASSRAW=

RABBITMQMAILING_USER=
RABBITMQMAILING_PASS=

RABBITMQMONITORING_USER=
RABBITMQMONITORING_PASS=

RABBITMQCHATBOT_USER=
RABBITMQCHATBOT_PASS=

RABBITMQ_USER_PLANNING=
RABBITMQ_PASS_PLANNING=

IDENTITY_RABBIT_USER=
IDENTITY_RABBIT_PASS=

# ── Facturatie (FossBilling) ───────────────────────────────────────────────────
FOSSBILLING_DB_NAME=
FOSSBILLING_DB_USER=
FOSSBILLING_DB_PASS=
# API token used by the facturatie-connector and facturatie-mcp sidecar
BILLING_API_TOKEN=
# Public URL of the FossBilling frontend — used in invoice notification emails
# Example: https://facturatie.desiderius.me
BILLING_WEB_URL=
# FossBilling admin account — used by the connector sidecar to authenticate via the API
BILLING_ADMIN_EMAIL=
BILLING_ADMIN_PASSWORD=

# ── Frontend (Drupal) ─────────────────────────────────────────────────────────
DRUPAL_DB_NAME=
DRUPAL_DB_USER=
DRUPAL_DB_PASS=
DRUPAL_ADMIN_USER=
DRUPAL_ADMIN_PASS=
DRUPAL_BASE_URL=

# ── Kassa (Odoo) ──────────────────────────────────────────────────────────────
ODOO_DB=
ODOO_USER=
ODOO_PASS=
ODOO_MASTER_PASS=

# ── Chatbot ───────────────────────────────────────────────────────────────────
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
CHATBOT_DB_NAME=
# Admin credentials for the chatbot management API (format: user:password)
ADMIN_SECRET=
ADMIN_CREDENTIALS=
# NVIDIA NIM API — used by the chatbot LLM backend
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_API_URL=

# ── Identity Service ──────────────────────────────────────────────────────────
DB_USER=
DB_PASSWORD=
DB_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
TOKEN_ENCRYPTION_KEY=
API_TOKEN_SECRET=

# ── Planning ──────────────────────────────────────────────────────────────────
PLANNING_DB_NAME=
PLANNING_API_TOKEN_SECRET=
# Azure AD credentials for Office 365 integration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
PLANNING_SERVICE_URL=

# ── CRM (Salesforce) ──────────────────────────────────────────────────────────
# MySQL credentials for the CRM integration database
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=
SF_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Mailing (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=
SENDGRID_TEMPLATE_INVOICE_READY=
SENDGRID_TEMPLATE_PAYMENT_CONFIRMATION=
SENDGRID_TEMPLATE_REGISTRATION_CONFIRMATION=
SENDGRID_TEMPLATE_SESSION_UPDATE=
SENDGRID_TEMPLATE_DAILY_REPORT=
SENDGRID_TEMPLATE_GENERAL_ANNOUNCEMENT=
# Comma-separated list of admin email addresses for system notifications
ADMIN_EMAILS=
# Also used by dev-on to blank SMTP credentials in the dev overlay
SMTP_USERNAME=
SMTP_PASSWORD=

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ── Monitoring (ELK) ──────────────────────────────────────────────────────────
ELASTIC_PASSWORD=
XPACK_SECURITY_ENCRYPTIONKEY=
XPACK_REPORTING_ENCRYPTIONKEY=
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token is managed in Cloudflare Zero Trust dashboard — paste here for bootstrap
CLOUDFLARE_TUNNEL_TOKEN=

# ── Teams Webhooks ────────────────────────────────────────────────────────────
# Incoming webhook URLs for Microsoft Teams notification channels per team
TEAMS_WEBHOOK_CRM=
TEAMS_WEBHOOK_FACTURATIE=
TEAMS_WEBHOOK_FRONTEND=
TEAMS_WEBHOOK_INFRA=
TEAMS_WEBHOOK_KASSA=
TEAMS_WEBHOOK_MONITORING=
TEAMS_WEBHOOK_PLANNING=

# ── RabbitMQ vhost (runtime — usually set via overlay or kubectl patch) ────────
# Production: /   Dev overlay: shift-festival-dev   (patched by dev-on.yml)
RABBITMQ_VHOST=/
RABBIT_VHOST=/
