# Development environment variables
# Secrets are NOT managed by kustomize secretGenerator — ArgoCD does not have filesystem access.
# To create the shift-secrets Kubernetes Secret, run:
#   ./scripts/create-secret.sh setup/.env shift-festival-dev
# Re-run this command whenever secrets change.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-password
ODOO_DB=odoo_kassa
ODOO_MASTER_PASS=dev-master-pass
FACTURATIE_DB_PASSWORD=dev-facturatie-pass
IDENTITY_SERVICE_TOKEN=dev-identity-token
PLANNING_TOKEN=dev-planning-token
CRM_TOKEN=dev-crm-token
HEARTBEAT_TOKEN=dev-heartbeat-token
