IDENTITY_SERVICE_TOKEN=change-me
PLANNING_TOKEN=change-me
CRM_TOKEN=change-me
HEARTBEAT_TOKEN=change-me
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
DRUPAL_BASE_URL=https://desiderius.me
